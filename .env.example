APP_ENV=development
APP_PORT=8001
APP_HOST=0.0.0.0
LOG_LEVEL=info

# String de conexão SQLAlchemy+pyodbc (dialeto diferente do Prisma, mesmo banco).
DATABASE_URL=mssql+pyodbc://sa:SUA_SENHA_AQUI@localhost:1433/pep?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes&Encrypt=yes

JWT_SECRET=troque-por-um-segredo-de-32-caracteres-no-minimo
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# 32 bytes em base64 — gerar com: python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=troque-por-32-bytes-em-base64

# Id da chave ativa, gravado dentro de cada payload cifrado. Só muda ao
# rotacionar — e a chave anterior TEM que ir para ENCRYPTION_KEYS_RETIRED,
# senão tudo que já está no banco fica ilegível.
ENCRYPTION_KEY_ID=1
# Chaves aposentadas, só para decifrar dado ainda não reescrito.
# JSON {"<id>": "<base64>"}. Vazio fora de uma rotação em andamento.
ENCRYPTION_KEYS_RETIRED=

CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate limit por IP. Defaults iguais aos do backend Fastify original
# (100/min no geral; 10 tentativas FALHAS/15 min nas rotas de login).
# RATE_LIMIT_ENABLED=false é só para testes — nunca em produção.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=900
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
# Ligue APENAS atrás de um reverse proxy que sobrescreva X-Forwarded-For.
# Sem proxy, o header é escrito pelo cliente e o limite vira burlável.
RATE_LIMIT_TRUST_FORWARDED_FOR=false

TOTVS_MOCK=true
TOTVS_BASE_URL=http://www.portal.fsa.br:8051
TOTVS_TIMEOUT_SECONDS=10
TOTVS_SENTENCA=Retorna_Vinculo
TOTVS_COLIGADA=1
TOTVS_SISTEMA=S
TOTVS_PARAM_NOME=USUARIO_S
TOTVS_PARAM_COM_ASPAS=false
TOTVS_TIPO_ALUNO=A
